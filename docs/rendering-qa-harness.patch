+// QA-only readback: verify the actual WKWebView uses the requested store.
+#[link(name = "objc")]
+extern "C" {
+    fn sel_registerName(name: *const std::ffi::c_char) -> *mut std::ffi::c_void;
+    #[link_name = "objc_msgSend"]
+    fn qa_message(receiver: *mut std::ffi::c_void, selector: *mut std::ffi::c_void) -> *mut std::ffi::c_void;
+}
+unsafe fn qa_store_identifier(mut object: *mut std::ffi::c_void) -> String {
+    for name in [c"configuration", c"websiteDataStore", c"identifier", c"UUIDString", c"UTF8String"] {
+        object = qa_message(object, sel_registerName(name.as_ptr()));
+        if object.is_null() { return "MISSING".into(); }
+    }
+    std::ffi::CStr::from_ptr(object.cast()).to_string_lossy().into_owned()
+}
